{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ABC handoff task board",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project",
    "plan_version",
    "date",
    "state",
    "statuses",
    "completion_policy",
    "tasks"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "project": {
      "const": "All-Basket Cryptography"
    },
    "plan_version": {
      "type": "string"
    },
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "state": {
      "const": "planning_artifact_not_implementation_evidence"
    },
    "statuses": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "completion_policy": {
      "type": "string",
      "minLength": 1
    },
    "tasks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/task"
      },
      "minItems": 1
    }
  },
  "$defs": {
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "milestone",
        "title",
        "depends_on",
        "owner_role",
        "status",
        "deliverables",
        "acceptance",
        "evidence",
        "blockers"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^ABC-\\d{3}$"
        },
        "milestone": {
          "enum": [
            "M0",
            "M1",
            "M2",
            "M3",
            "M4",
            "M5"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "depends_on": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^ABC-\\d{3}$"
          }
        },
        "owner_role": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "not_started",
            "ready",
            "in_progress",
            "blocked",
            "in_review",
            "done"
          ]
        },
        "deliverables": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "acceptance": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "blockers": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
