{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ABC module manifest version 1",
  "description": "Validation of the data model decoded from module.toml.",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "owned_paths": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/path"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "shared_inputs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/path"
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "cargo_manifests": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/path"
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "lean_sources": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/path"
      }
    },
    "lean_external_imports": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/path"
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "module": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "type": {
            "enum": [
              "imports",
              "calls",
              "implements",
              "wraps",
              "generated_from",
              "tests",
              "packages",
              "constrained_by"
            ]
          }
        },
        "required": [
          "module",
          "type"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "tasks": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/$defs/task"
      }
    }
  },
  "required": [
    "schema_version",
    "id",
    "owned_paths",
    "tasks"
  ],
  "additionalProperties": false,
  "$defs": {
    "path": {
      "type": "string",
      "pattern": "^[^\\\\/:<>|\"*?\\u0000-\\u001f]+(/[^\\\\/:<>|\"*?\\u0000-\\u001f]+)*$"
    },
    "task": {
      "type": "object",
      "properties": {
        "command": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*(:[a-z][a-z0-9-]*)?$"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "inputs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/path"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "outputs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/path"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "kind": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "always": {
          "type": "boolean"
        },
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3600
        },
        "features": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "target": {
          "type": "string",
          "minLength": 1
        },
        "tools": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0,
          "uniqueItems": true
        }
      },
      "required": [
        "command",
        "kind"
      ],
      "additionalProperties": false
    }
  }
}
