<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>12.0</LangVersion>
    <CheckForOverflowUnderflow>true</CheckForOverflowUnderflow>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <PackageId>Abc.Cryptography.Scrypt</PackageId>
    <Version>0.1.0</Version>
    <Description>Managed scrypt for ABC research.</Description>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Scrypt.cs" />
    <ProjectReference Include="../../../pbkdf2-hmac-sha256/impl/csharp/Abc.Cryptography.Pbkdf2Sha256.csproj" />
  </ItemGroup>
</Project>
