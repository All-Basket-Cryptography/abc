if(TARGET ABC::cpp)
    return()
endif()

include(CMakeFindDependencyMacro)
find_dependency(ABCCrypto 0.1 CONFIG)
get_filename_component(_abc_cpp_prefix "${CMAKE_CURRENT_LIST_DIR}/../../.." ABSOLUTE)

add_library(ABC::cpp INTERFACE IMPORTED)
set_target_properties(ABC::cpp PROPERTIES
    INTERFACE_INCLUDE_DIRECTORIES "${_abc_cpp_prefix}/include"
    INTERFACE_LINK_LIBRARIES ABC::c
    INTERFACE_COMPILE_FEATURES cxx_std_17)

unset(_abc_cpp_prefix)
